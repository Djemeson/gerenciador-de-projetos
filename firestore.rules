rules_version = '2';

// App de uso pessoal com login pelo Google (ver DIRETRIZES.md, seção 15). Cada conta mora
// em syncGroups/{uid} (documento principal + subcoleções), e só o dono daquele uid lê e
// escreve — não existe mais grupo compartilhado por código.
//
// A exceção são os grupos legados (código TF-XXXXXX do modelo antigo, sem login): eles
// continuam LEGÍVEIS por qualquer usuário autenticado apenas para a migração única dos
// dados para a conta Google. Depois que todos os dispositivos migrarem, esse bloco pode
// ser removido — e com ele o último resquício de acesso compartilhado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /syncGroups/{group} {
      allow read, write: if request.auth != null && group == request.auth.uid;
      allow read:        if request.auth != null && group.matches('^TF-.*');

      // Formato 2 (shared/formatoConta.ts): um documento por tarefa e por projeto.
      // Só o dono — não há grupo legado neste formato.
      match /tarefas/{tarefaId} {
        allow read, write: if request.auth != null && group == request.auth.uid;
      }
      match /projetos/{projetoId} {
        allow read, write: if request.auth != null && group == request.auth.uid;
      }

      // Subcoleção de blobs (anexos/áudios grandes demais para o documento principal).
      match /attachments/{attachmentId} {
        allow read, write: if request.auth != null && group == request.auth.uid;
        allow read:        if request.auth != null && group.matches('^TF-.*');
      }
    }
  }
}
