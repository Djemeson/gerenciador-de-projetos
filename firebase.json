{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "server.cjs", "server.cjs.map"],
    "predeploy": ["npm run build"],
    "rewrites": [
      { "source": "/api/mcp", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "/api/mcp/**", "function": { "functionId": "mcp", "region": "us-central1" } },
      { "source": "/api/claude-chave", "function": { "functionId": "claudeChave", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "/assets/**", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix functions run build"],
      "ignore": ["node_modules", "src", "tsconfig.json", ".gitignore"]
    }
  ]
}
